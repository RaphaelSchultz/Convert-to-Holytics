# ============================================
# Convert-to-Holytics - Environment Variables
# ============================================
# Copy this file to .env and adjust values

# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000

# Database Configuration
# Default path for Louvor JA database
# Windows: C:\Program Files (x86)\Louvor JA\config\database.db
# Linux/Mac: Adjust accordingly
DEFAULT_DB_PATH=C:\Program Files (x86)\Louvor JA\config\database.db

# Export Configuration
OUTPUT_DIR=musicas_txt_formatadas

# Security (add when implementing authentication)
# SECRET_KEY=your-secret-key-here
# API_KEY=your-api-key-here

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
